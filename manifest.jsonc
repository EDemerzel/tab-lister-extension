{
  "manifest_version": 3, // Required for Chrome extensions now using Manifest V3
  "name": "Tab Lister", // Display name of the extension
  "version": "1.4",  // Versioning; update on any new release or changes
  "description": "List all open tabs, copy them to clipboard, or save them as a file.",
  "permissions": [
    "tabs",         // Allow access to query open tabs
    "activeTab",    // Provides temporary access to the current active tab
    "clipboardWrite" // Grants permission to write data to the clipboard
  ],
  "action": {
    "default_popup": "popup.html", // Specifies the HTML file launched when clicking the extension icon
    "default_icon": {              // Icons used in the extension toolbar
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {  // Additional icons used when listing the extension in Chrome's Extensions page
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}